# ─────────────────────────────────────────────
# HypoKiln — environment configuration
# Copy to .env (or .env.local) and fill in your keys.
# Sensitive keys must be empty in this committed example.
# ─────────────────────────────────────────────


# ── Coding-CLI binary ────────────────────────
# HypoKiln spawns ONE of these per stage as a subprocess. Auth comes
# from the CLI's own session file (~/.codex/auth.json, ~/.claude/, etc.).
# HypoKiln itself never reads your session token.
#
#   codex   — ChatGPT Plus / Pro / Team
#   claude  — Claude.ai Pro / Team
#   gemini  — Google AI Studio account
#
HYPOKILN_CLI_BIN=codex
HYPOKILN_CLI_TIMEOUT=1800

# Optional overrides — absolute paths to each CLI if not on PATH.
HYPOKILN_CODEX_BIN=
HYPOKILN_CLAUDE_BIN=
HYPOKILN_GEMINI_BIN=

# ── Critique loops ───────────────────────────
# Wrapped stages run author → deterministic gate → critic-feedback → revise
# until the gate passes or HYPOKILN_CRITIQUE_MAX_ITER iterations exhaust.
HYPOKILN_CRITIQUE_MAX_ITER=3
HYPOKILN_DISABLE_CRITIQUE=0

# ── Skills ───────────────────────────────────
# Per-skill-pack budget when inlining into per-stage prompts.
HYPOKILN_SKILL_BUDGET=131072
HYPOKILN_SKIP_SKILLS=0

# ── Orchestrator behaviour ───────────────────
# 1 = auto-sign G1 (the only human gate before the public release scope ends).
HYPOKILN_AUTONOMOUS=0

# Where the pipeline persists state per product run.
HYPOKILN_STATE_DIR=.hypokiln/state

# ── Control plane / web dashboard ────────────
# Optional — only needed if you run `make dev` for the web UI.
NEXT_PUBLIC_HYPOKILN_API_URL=http://localhost:8765

# ── Telegram notifications (optional) ────────
# Background watcher pings on blocked / failed / completed transitions.
HYPOKILN_TG_BOT_TOKEN=
HYPOKILN_TG_CHAT_ID=
HYPOKILN_NOTIFY_EVENTS=blocked,failed,completed
